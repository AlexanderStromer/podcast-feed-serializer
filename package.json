{
  "name": "podcast-feed-serializer",
  "version": "1.0.4",
  "description": "Serialize & Deserialize RSS Feeds for Podcasts into objects",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "test": "jest --config jestconfig.json",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "tslint -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "rss",
    "podcast",
    "serializer",
    "mp3"
  ],
  "author": "Alexander Stromer <alexander.stromer@gmail.com> (https://github.com/AlexanderStromer)",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexanderStromer/podcast-feed-serializer"
  },
  "files": [
    "lib/**/*"
  ],
  "license": "MIT",
  "dependencies": {
    "moment": "^2.30.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/xml2js": "^0.4.14",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^5.6.2"
  }
}
